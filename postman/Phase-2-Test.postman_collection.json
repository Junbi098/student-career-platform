          "mode": "raw",
          "raw": "{\"version\":{{version}},\"opportunity\":{{updatedBody}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data=JSON.parse(pm.collectionVariables.get(\"opportunityBody\")); data.title+=\" actualisé\"; pm.collectionVariables.set(\"updatedBody\",JSON.stringify(data));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu\", function(){ pm.response.to.have.status(200); });",
              "const data=pm.response.json(); pm.collectionVariables.set(\"opportunityId\",data.id); pm.collectionVariables.set(\"version\",data.version);",
              "pm.test(\"Nouvelle vérification nécessaire\",function(){ pm.expect(data.status).to.eql(\"UNVERIFIED\"); pm.expect(data.lastVerifiedAt).to.eql(null); });"
            ]
          }
        }
      ]
    },

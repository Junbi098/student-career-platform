          "mode": "raw",
          "raw": "{\"version\":{{version}},\"action\":\"CONFIRM\",\"sourceReviewed\":false,\"evidenceUrl\":\"{{sourceUrl}}\",\"notes\":\"Simulation dans une base de test\"}",
          "options": {
            "raw": {
              "language": "json"
            }

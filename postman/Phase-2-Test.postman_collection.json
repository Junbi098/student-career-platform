          "raw": "{\"version\":{{version}},\"action\":\"CONFIRM\",\"sourceReviewed\":true,\"evidenceUrl\":\"{{sourceUrl}}\",\"notes\":\"Confirmation simulée uniquement pour ce test fictif\"}",

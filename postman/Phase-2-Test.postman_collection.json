    {
      "name": "18 - Détecter une annonce JobPosting dans un HTML fourni",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities/imports/html",
        "body": {
          "mode": "raw",
          "raw": "{{htmlBody}}",
          "options": {
            "raw": {
              "language": "json"
            }

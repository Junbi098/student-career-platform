        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token=pm.collectionVariables.get(\"runToken\");",
              "const job={\"@context\":\"https://schema.org\",\"@type\":\"JobPosting\",title:\"HTML Java \"+token,description:\"<p>Annonce structurée fictive pour les tests.</p>\",employmentType:\"INTERN\",validThrough:\"2099-12-31\",identifier:{value:\"HTML-\"+token},hiringOrganization:{name:pm.collectionVariables.get(\"companyName\")}};",
              "const request={companyId:pm.collectionVariables.get(\"companyId\"),sourceUrl:\"https://example.test/html/\"+token,sourceTitle:\"Document HTML synthétique\",html:\"<script type='application/ld+json'>\"+JSON.stringify(job)+\"</script>\"};",
              "pm.collectionVariables.set(\"htmlBody\",JSON.stringify(request));"

{
  "info": {
    "name": "PHASE 2 - TESTS ISOLÉS UNIQUEMENT",
    "description": "Lancer Start-TestApi.ps1 et utiliser la base student_career_test. Chaque requête vérifie la base via /api/status avant exécution. Aucun appel aux sites employeurs. Exécuter dans l’ordre pour mémoriser les identifiants et versions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const status = await pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/status\");",
          "if (status.code !== 200 || status.json().database !== \"student_career_test\") {",
          "    console.error(\"Parcours fictif réservé à student_career_test. Lancer Start-TestApi.ps1.\");",
          "    pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Confirmer la base de test",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu\", function(){ pm.response.to.have.status(200); });",
              "pm.test(\"Base isolée\", function(){ pm.expect(pm.response.json().database).to.eql(\"student_career_test\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Préparer les entreprises fictives dans la base de test",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/imports/demo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu\", function(){ pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Choisir une entreprise de test",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/companies?q=Island&size=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu\", function(){ pm.response.to.have.status(200); });",
              "const company=pm.response.json().items[0];",
              "pm.collectionVariables.set(\"companyId\",company.id); pm.collectionVariables.set(\"companyName\",company.company.name);",
              "pm.collectionVariables.set(\"runToken\",\"TESTPHASE2\"+Date.now());"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Créer une opportunité non vérifiée",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{{opportunityBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token=pm.collectionVariables.get(\"runToken\");",
              "const input={companyId:pm.collectionVariables.get(\"companyId\"),title:\"Stage Java \"+token,type:\"INTERNSHIP\",description:\"Annonce fictive pour apprendre les tests dans la base isolée.\",sector:\"Software\",location:\"Ébène, Mauritius\",workMode:\"HYBRID\",publishedOn:\"2020-01-01\",deadline:\"2099-12-31\",sourceUrl:\"https://example.test/jobs/\"+token,sourceTitle:\"Annonce synthétique de test\",externalReference:token,mauritianEligibility:\"UNKNOWN\",internationalEligibility:\"UNKNOWN\"};",
              "pm.collectionVariables.set(\"opportunityBody\",JSON.stringify(input));",
              "pm.collectionVariables.set(\"sourceUrl\",input.sourceUrl);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu\", function(){ pm.response.to.have.status(201); });",
              "const data=pm.response.json(); pm.collectionVariables.set(\"opportunityId\",data.id); pm.collectionVariables.set(\"version\",data.version);",
              "pm.test(\"Pas de confirmation automatique\",function(){ pm.expect(data.status).to.eql(\"UNVERIFIED\"); pm.expect(data.sourceFetchedByServer).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Lire son dossier",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/opportunities/{{opportunityId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
